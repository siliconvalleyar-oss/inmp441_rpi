// Overlay I2S "bare" para INMP441 / micrófono I2S esclavo.
//
// Basado en googlevoicehat-soundcard (usa el codec "google,voicehat" que
// expone captura Y reproducción) pero con la CPU I2S como MASTER del reloj
// (bitclock/frame-master = CPU). El overlay original deja la CPU como esclava
// y el codec dummy no genera reloj -> el bus nunca se activa y ALSA graba
// silencio. Con la CPU como master, BCLK (GPIO18) y WS (GPIO19) se generan y
// el INMP441 (esclavo) entrega datos por GPIO20.
//
// Formato I2S, TDM 2 slots x 32 bits (lo mismo que lee el driver nativo).
//
// Instalación:
//   dtc -@ -I dts -O dtb -o inmp441-bare.dtbo inmp441-bare.dts
//   sudo cp inmp441-bare.dtbo /boot/firmware/overlays/
//   # en config.txt: dtoverlay=inmp441-bare
/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2835";

	fragment@0 {
		target = <&i2s_clk_producer>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@1 {
		target = <&gpio>;
		__overlay__ {
			inmp441_pins: inmp441_pins {
				brcm,pins = <16>;
				brcm,function = <1>; /* out */
				brcm,pull = <0>; /* none */
			};
		};
	};

	fragment@2 {
		target-path = "/";
		__overlay__ {
			voicehat_codec: voicehat-codec {
				#sound-dai-cells = <0>;
				compatible = "google,voicehat";
				pinctrl-names = "default";
				pinctrl-0 = <&inmp441_pins>;
				sdmode-gpios = <&gpio 16 0>;
				status = "okay";
			};
		};
	};

	fragment@3 {
		target = <&sound>;
		__overlay__ {
			compatible = "simple-audio-card";
			i2s-controller = <&i2s_clk_producer>;
			status = "okay";

			simple-audio-card,name = "inmp441-bare";
			simple-audio-card,format = "i2s";

			simple-audio-card,bitclock-master = <&dailink0_master>;
			simple-audio-card,frame-master = <&dailink0_master>;

			dailink0_master: simple-audio-card,cpu {
				sound-dai = <&i2s_clk_producer>;
				dai-tdm-slot-num = <2>;
				dai-tdm-slot-width = <32>;
			};

			simple-audio-card,codec {
				sound-dai = <&voicehat_codec>;
			};
		};
	};
};
