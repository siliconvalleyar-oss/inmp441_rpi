// Overlay I2S "bare" para INMP441 / micrófono I2S esclavo.
//
// Usa el codec genérico "dmic-codec" (snd-soc-dmic), el driver estándar del
// kernel para micrófonos MEMS digitales, en lugar del dummy "google,voicehat"
// (que requería un GPIO de sdmode del HAT de amplificador y expone captura y
// reproducción que aquí no se usan). La CPU I2S actúa como MASTER del reloj
// (bitclock/frame-master = CPU), igual que la variante "master" del proyecto
// de referencia admp441-rpi. El overlay original deja la CPU como esclava y
// el codec dummy no genera reloj -> el bus nunca se activa y ALSA graba
// silencio. Con la CPU como master, BCLK (GPIO18) y WS (GPIO19) se generan y
// el INMP441 (esclavo) entrega datos por GPIO20.
//
// Formato I2S, TDM 2 slots x 32 bits (lo mismo que lee el driver nativo).
//
// Instalación:
//   dtc -@ -I dts -O dtb -o inmp441-bare.dtbo inmp441-bare.dts
//   sudo cp inmp441-bare.dtbo /boot/firmware/overlays/
//   # en config.txt: dtoverlay=inmp441-bare[,alsaname=mems-mic]
/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2835";

	fragment@0 {
		target = <&i2s_clk_producer>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@1 {
		target-path = "/";
		__overlay__ {
			mic_codec: dmic-codec {
				#sound-dai-cells = <0>;
				compatible = "dmic-codec";
				num-channels = <2>;
				status = "okay";
			};
		};
	};

	fragment@2 {
		target = <&sound>;
		__overlay__ {
			compatible = "simple-audio-card";
			status = "okay";

			simple-audio-card,name = "inmp441-bare";
			simple-audio-card,format = "i2s";

			simple-audio-card,bitclock-master = <&dailink0_master>;
			simple-audio-card,frame-master = <&dailink0_master>;

			dailink0_master: simple-audio-card,cpu {
				sound-dai = <&i2s_clk_producer>;
				dai-tdm-slot-num = <2>;
				dai-tdm-slot-width = <32>;
			};

			simple-audio-card,codec {
				sound-dai = <&mic_codec>;
			};
		};
	};

	__overrides__ {
		alsaname = <&sound>, "simple-audio-card.name";
	};
};
